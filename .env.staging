# `npm run dev:staging`: the real staging API, no mock data. Committed: nothing secret here.
# Values here win over .env.local (Vite loads .env.[mode] after .env.local).
VITE_API_URL=https://api-staging.docuhealthservices.net
# The dev server proxies /api to VITE_API_URL, so staging's CORS list doesn't matter and the
# hospital./admin./agent.localhost sections all work.
VITE_API_PROXY=true
VITE_ENABLE_MOCKS=false
VITE_PREFILL_FORMS=false
