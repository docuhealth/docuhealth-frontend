# Copy to `.env.local` and fill in. Only VITE_* vars reach app code (via src/env.ts,
# which validates them at startup). They are inlined into the JS bundle at build
# time, so never put secrets here.
# Docs: https://vite.dev/guide/env-and-mode

VITE_API_URL=https://api-staging.docuhealthservices.net
# Optional — leave empty to disable error reporting.
VITE_SENTRY_DSN=
# Main domain; hospital., admin. and agent. subdomains of it open those sections of the app.
# Leave empty to use path prefixes instead (/hospital/…) — e.g. on preview deploys.
VITE_ROOT_DOMAIN=docuhealthservices.net
# true = fake the API in the browser with MSW (src/mocks/handlers.ts)
VITE_ENABLE_MOCKS=true
# true = fill forms with sample data so you can click through them (dev server only)
VITE_PREFILL_FORMS=true
