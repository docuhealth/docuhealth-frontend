# Copy to `.env.local` and fill in. Only VITE_* vars reach app code (via src/env.ts,
# which validates them at startup). They are inlined into the JS bundle at build
# time, so never put secrets here.
# Docs: https://vite.dev/guide/env-and-mode

VITE_API_URL=https://api-staging.docuhealthservices.net
# Optional — leave empty to disable error reporting.
VITE_SENTRY_DSN=
# true = fake the API in the browser with MSW (src/mocks). Demo login: admin@example.com / password123
VITE_ENABLE_MOCKS=true
