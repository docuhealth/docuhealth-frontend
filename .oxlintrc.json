{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": ["dist", "coverage", "src/routeTree.gen.ts", "public/mockServiceWorker.js"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "typescript/consistent-type-imports": "error",
    "import/no-cycle": "error",
    "eslint/no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../**"],
            "message": "Use the @/ alias instead of parent-relative imports."
          }
        ]
      }
    ],
    "vitest/require-mock-type-parameters": "off"
  },
  "overrides": [
    {
      "files": ["src/features/*/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**"],
                "message": "Use the @/ alias instead of parent-relative imports."
              },
              {
                "group": ["@/routes/**"],
                "message": "Features can't import routes. Routes compose features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**", "src/lib/**", "src/stores/**", "src/hooks/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**"],
                "message": "Use the @/ alias instead of parent-relative imports."
              },
              {
                "group": ["@/features/**", "@/routes/**"],
                "message": "Shared code can't depend on features or routes."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["src/components/ui/**", "src/hooks/use-mobile.ts"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "react/set-state-in-effect": "off",
        "react/only-export-components": "off"
      }
    }
  ]
}
