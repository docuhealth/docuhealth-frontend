{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],

    "jsx": "react-jsx",

    "strict": true,

    "allowJs": true,
    "checkJs": false,

    "noEmit": true,

    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}